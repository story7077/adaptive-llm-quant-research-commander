{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-llm-quant.example/schemas/candidate-test-manifest-v1.schema.json",
  "title": "CandidateTestManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_run_id",
    "execution_contract_version",
    "runner_code_hash",
    "invocation_id",
    "builder_context_hash",
    "source_snapshot_hash",
    "candidate_tree_hash_before",
    "candidate_tree_hash_after",
    "candidate_tree_unchanged",
    "patch_hash",
    "proposal_hash",
    "builder_result_hash",
    "declared_entrypoint",
    "declared_tests",
    "host_abi_test_hash_before",
    "host_abi_test_hash_after",
    "host_abi_test_unchanged",
    "candidate_test_projection_hash_before",
    "candidate_test_projection_hash_after",
    "candidate_test_projection_unchanged",
    "candidate_source_projection_hash_before",
    "candidate_source_projection_hash_after",
    "candidate_source_projection_unchanged",
    "command_hash",
    "runtime",
    "limits",
    "status",
    "exit_code",
    "duration_ms",
    "test_count",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_bytes",
    "stderr_bytes",
    "output_limit_exceeded",
    "raw_output_persisted",
    "network_access_permitted",
    "credential_access_permitted",
    "broker_access_permitted",
    "host_principal_persisted",
    "real_order_routing"
  ],
  "properties": {
    "schema_version": { "const": "candidate_test_manifest_v1" },
    "test_run_id": { "$ref": "#/$defs/identifier" },
    "execution_contract_version": {
      "const": "candidate-test-unelevated-workspace-v1"
    },
    "runner_code_hash": { "$ref": "#/$defs/sha256" },
    "invocation_id": { "$ref": "#/$defs/identifier" },
    "builder_context_hash": { "$ref": "#/$defs/sha256" },
    "source_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "candidate_tree_hash_before": { "$ref": "#/$defs/sha256" },
    "candidate_tree_hash_after": { "$ref": "#/$defs/sha256" },
    "candidate_tree_unchanged": { "type": "boolean" },
    "patch_hash": { "$ref": "#/$defs/sha256" },
    "proposal_hash": { "$ref": "#/$defs/sha256" },
    "builder_result_hash": { "$ref": "#/$defs/sha256" },
    "declared_entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "declared_tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_path" }
    },
    "host_abi_test_hash_before": { "$ref": "#/$defs/sha256" },
    "host_abi_test_hash_after": { "$ref": "#/$defs/sha256" },
    "host_abi_test_unchanged": { "type": "boolean" },
    "candidate_test_projection_hash_before": { "$ref": "#/$defs/sha256" },
    "candidate_test_projection_hash_after": { "$ref": "#/$defs/sha256" },
    "candidate_test_projection_unchanged": { "type": "boolean" },
    "candidate_source_projection_hash_before": { "$ref": "#/$defs/sha256" },
    "candidate_source_projection_hash_after": { "$ref": "#/$defs/sha256" },
    "candidate_source_projection_unchanged": { "type": "boolean" },
    "command_hash": { "$ref": "#/$defs/sha256" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "abi_tag", "executable_sha256"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "abi_tag": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_output_bytes",
        "max_job_memory_bytes",
        "max_processes"
      ],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_job_memory_bytes": { "type": "integer", "minimum": 1 },
        "max_processes": { "type": "integer", "minimum": 1 }
      }
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "TIMED_OUT",
        "RESOURCE_LIMIT",
        "PROCESS_ERROR",
        "INTEGRITY_FAILURE"
      ]
    },
    "exit_code": { "type": ["integer", "null"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "test_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected",
        "passed",
        "failed",
        "skipped",
        "errors",
        "xfailed",
        "xpassed",
        "deselected"
      ],
      "properties": {
        "collected": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "xfailed": { "type": "integer", "minimum": 0 },
        "xpassed": { "type": "integer", "minimum": 0 },
        "deselected": { "type": "integer", "minimum": 0 }
      }
    },
    "stdout_sha256": { "$ref": "#/$defs/sha256" },
    "stderr_sha256": { "$ref": "#/$defs/sha256" },
    "stdout_bytes": { "type": "integer", "minimum": 0 },
    "stderr_bytes": { "type": "integer", "minimum": 0 },
    "output_limit_exceeded": { "type": "boolean" },
    "raw_output_persisted": { "const": false },
    "network_access_permitted": { "const": false },
    "credential_access_permitted": { "const": false },
    "broker_access_permitted": { "const": false },
    "host_principal_persisted": { "const": false },
    "real_order_routing": { "const": false }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safe_path": {
      "type": "string",
      "pattern": "^(?:tests/unit|tests/property|tests/research)/[A-Za-z0-9._/-]+\\.py$"
    }
  }
}
